<UserControl x:Class="Chibinator.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">

            <TextBlock Text="Settings" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,0,0,4"/>
            <TextBlock Text="Configure Chibinator behaviour and Roblox path"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,24"/>

            <!-- ROBLOX PATH -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ROBLOX INSTALLATION" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                    <TextBlock Text="Executable Path" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding RobloxPathOverride, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding BrowseRobloxPathCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Re-detect" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding RedetectRobloxCommand}"/>
                    </Grid>
                    <TextBlock Text="Leave blank to auto-detect. Only needed if Roblox is in a non-standard location."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" FontFamily="Segoe UI" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- LAUNCH BEHAVIOUR -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="LAUNCH BEHAVIOUR" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto-apply on launch"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontFamily="Segoe UI"/>
                            <TextBlock Text="Automatically apply the active profile every time you launch"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding AutoApplyOnLaunch}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Backup config before apply"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontFamily="Segoe UI"/>
                            <TextBlock Text="Saves a timestamped backup of ClientAppSettings.json before overwriting"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding BackupBeforeApply}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Margin="0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Launch delay (ms)"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontFamily="Segoe UI"/>
                            <TextBlock Text="Delay between writing config and starting Roblox (recommended: 500)"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" FontFamily="Segoe UI" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" VerticalAlignment="Center"
                                 Text="{Binding LaunchDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" TextAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- HARDWARE INFO -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DETECTED HARDWARE" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding HardwareInfo}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Consolas" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Suggested preset: " Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border Padding="8,3" CornerRadius="4" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="{Binding SuggestedPreset}"
                                       Foreground="White" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ABOUT -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ABOUT CHIBINATOR" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               FontFamily="Segoe UI" TextWrapping="Wrap">
                        <TextBlock.Inlines>
                            <Run FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">Chibinator v1.0</Run>
                            <Run> — Roblox Ultra Performance Launcher</Run>
                        </TextBlock.Inlines>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,8,0,0">
                        Chibinator optimizes Roblox by writing to ClientAppSettings.json using Roblox's officially allowlisted FastFlags only. No binary modification, no process injection, no cheating. Backups stored in %LocalAppData%\Chibinator\Backups\
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button Content="💾  Save Settings" Style="{StaticResource ButtonPrimary}"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Right" Padding="20,11"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
